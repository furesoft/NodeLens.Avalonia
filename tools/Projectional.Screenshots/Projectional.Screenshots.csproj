<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A sample/tool, not a product: nothing depends on it, so it is not a package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Projectional.Avalonia\Projectional.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Languages\Samples\Projectional.Samples\Projectional.Samples.csproj" />
    <!--
      The three worked examples are languages of their own, and a picture of one has to be drawn by that language's
      own notation registry - so the tool references them rather than pretending they look like the sample.
    -->
    <ProjectReference Include="..\..\src\Languages\Samples\Projectional.Samples.StateMachine\Projectional.Samples.StateMachine.csproj" />
    <ProjectReference Include="..\..\src\Languages\Samples\Projectional.Samples.FeatureModel\Projectional.Samples.FeatureModel.csproj" />
    <ProjectReference Include="..\..\src\Languages\Samples\Projectional.Samples.SqlSchema\Projectional.Samples.SqlSchema.csproj" />
    <!--
      The shell's own features - a run's output panel, a document's generators - are states of the window, so the
      tool hosts the shipping MainWindow for them. Nothing is reimplemented here: the picture is the app.
    -->
    <ProjectReference Include="..\..\src\Projectional.Workbench\Projectional.Workbench.csproj" />
    <!--
      A language's tests are documents of the test language, so a picture of one is drawn by that language's own
      notation registry, exactly as a picture of a sample language is.
    -->
    <ProjectReference Include="..\..\src\Projectional.Testing\Projectional.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A picture of a language's own tests has to run the folder the tests belong to, and a LanguageProject is loaded
      from disk - so the declared sample is copied into the tool's output, the way the test project copies it. It is
      the sample a user opens, not a fixture: the picture is therefore of the real documents.
    -->
    <None Include="..\..\samples\declared-pipeline\**\*.mps" Link="declared-pipeline\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\declared-pipeline\**\*.ini" Link="declared-pipeline\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
