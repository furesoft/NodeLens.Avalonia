    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Projectional.Avalonia\Projectional.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Checks\Projectional.Checks.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Core\Projectional.Core.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Editing\Projectional.Editing.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Editors\Projectional.Editors.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Expressions\Projectional.Expressions.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Intentions\Projectional.Intentions.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Expressions.Intentions\Projectional.Expressions.Intentions.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Language\Projectional.Language.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Languages\Projectional.Languages.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Persistence\Projectional.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Projection\Projectional.Projection.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Samples\Projectional.Samples.csproj" />
