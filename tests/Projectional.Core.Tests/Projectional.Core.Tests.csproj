    <ProjectReference Include="..\..\src\Projectional.Workbench\Projectional.Workbench.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Corpus\**\*.mps" CopyToOutputDirectory="PreserveNewest" />
    <!--
      The declared sample language lives at the repository root because it is what a user opens, not a
      fixture. The test copies it so it can load the same folder the app does.
    -->
    <None Include="..\..\samples\declared-pipeline\**\*.mps"
          Link="Declared\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
