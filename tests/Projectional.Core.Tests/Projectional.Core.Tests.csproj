<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Projectional.Avalonia\Projectional.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Checks\Projectional.Checks.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.ConstraintRules\Projectional.ConstraintRules.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Core\Projectional.Core.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Editing\Projectional.Editing.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Editors\Projectional.Editors.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Expressions\Projectional.Expressions.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.IntentionRules\Projectional.IntentionRules.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Intentions\Projectional.Intentions.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Json\Projectional.Json.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Language\Projectional.Language.csproj" />
    <ProjectReference Include="..\..\src\Projectional.LanguageExport\Projectional.LanguageExport.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Languages\Projectional.Languages.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Persistence\Projectional.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Projection\Projectional.Projection.csproj" />
    <ProjectReference Include="..\..\src\Languages\Samples\Projectional.Samples\Projectional.Samples.csproj" />
    <ProjectReference Include="..\..\src\Languages\Samples\Projectional.Samples.StateMachine\Projectional.Samples.StateMachine.csproj" />
    <ProjectReference Include="..\..\src\Languages\Samples\Projectional.Samples.FeatureModel\Projectional.Samples.FeatureModel.csproj" />
    <ProjectReference Include="..\..\src\Languages\Samples\Projectional.Samples.SqlSchema\Projectional.Samples.SqlSchema.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Semantics\Projectional.Semantics.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Structures\Projectional.Structures.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.TypeRules\Projectional.TypeRules.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Workbench\Projectional.Workbench.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.TextGen\Projectional.TextGen.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Xml\Projectional.Xml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Corpus\**\*.mps" CopyToOutputDirectory="PreserveNewest" />
    <!--
      The text corpus is what the reference languages generate, so a round trip can be compared byte for byte.
      Never regenerate one of these files to make a test pass - a byte that moves is a language bug or a
      deliberate change with a note in the commit (docs/architecture/import.md).
    -->
    <None Update="Corpus\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Corpus\**\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <!--
      The declared sample language lives at the repository root because it is what a user opens, not a
      fixture. The test copies it so it can load the same folder the app does.
    -->
    <None Include="..\..\samples\declared-pipeline\**\*.mps" Link="Declared\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\declared-workflow\**\*.mps" Link="Workflow\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Languages\Samples\Projectional.Samples.StateMachine\Corpus\**\*.mps" Link="StateMachine\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Languages\Samples\Projectional.Samples.FeatureModel\Corpus\**\*.mps" Link="FeatureModel\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Languages\Samples\Projectional.Samples.SqlSchema\Corpus\**\*.mps" Link="SqlSchema\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
