@* One small inline icon, drawn instead of loaded so it inherits the shell's colour. *@
<svg class="pn-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
    @if (Kind == "language")
    {
        <path d="M2.5 3.2c2-.7 3.7-.5 5.5.5v9.1c-1.8-1-3.5-1.2-5.5-.5z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
        <path d="M13.5 3.2c-2-.7-3.7-.5-5.5.5v9.1c1.8-1 3.5-1.2 5.5-.5z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
    }
    else
    {
        <path d="M4 1.8h5l3 3v9.4H4z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
        <path d="M9 1.8v3h3" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
    }
</svg>

@code {
    /// <summary>Which icon to draw: <c>document</c> (the default) or <c>language</c>.</summary>
    [Parameter]
    public string Kind { get; set; } = "document";
}
