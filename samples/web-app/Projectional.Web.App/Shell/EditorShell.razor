@* The shell's frame: menu bar, tabs, project explorer, the painted editor, the problems panel and the status bar. *@
<div class="pn-shell @(_dark ? "pn-dark" : string.Empty)" style="@RootStyle">

    <header class="pn-menubar">
        <a class="pn-brand" href="../" target="_top" title="Back to the language documentation">Projectional</a>

        <nav class="pn-menus" aria-label="Menu">
            <div class="pn-menu">
                <button type="button" class="pn-menu-title" @onclick='() => ToggleMenu("file")'>File</button>
                @if (_menu == "file")
                {
                    <div class="pn-dropdown">
                        <div class="pn-section">New document</div>
                        @if (Languages.Count == 0)
                        {
                            <div class="pn-entry pn-disabled">Reading the example languages…</div>
                        }
                        else
                        {
                            @foreach (var language in Languages)
                            {
                                var chosen = language;

                                <button type="button" class="pn-entry" @onclick="() => NewDocument(chosen, sample: false)">
                                    <span>@chosen.Name</span>
                                </button>
                            }
                        }

                        <div class="pn-section">Examples</div>
                        @foreach (var language in Languages)
                        {
                            var chosen = language;

                            <button type="button" class="pn-entry" @onclick="() => NewDocument(chosen, sample: true)">
                                <span>@chosen.Name example</span>
                            </button>
                        }

                        <div class="pn-separator"></div>
                        <label class="pn-entry pn-file">
                            <span>Open .mps…</span>
                            <InputFile OnChange="OpenFileAsync" accept=".mps,.xml" />
                        </label>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick="Save">
                            <span>Save in this browser</span><kbd>Ctrl+S</kbd>
                        </button>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick="DownloadActiveAsync">
                            <span>Download .mps</span>
                        </button>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick="RenameActiveAsync">
                            <span>Rename document…</span>
                        </button>
                        <div class="pn-separator"></div>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick="CloseActive">
                            <span>Close document</span>
                        </button>
                    </div>
                }
            </div>

            <div class="pn-menu">
                <button type="button" class="pn-menu-title" @onclick='() => ToggleMenu("edit")'>Edit</button>
                @if (_menu == "edit")
                {
                    <div class="pn-dropdown">
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick="UndoActive">
                            <span>Undo</span><kbd>Ctrl+Z</kbd>
                        </button>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick="RedoActive">
                            <span>Redo</span><kbd>Ctrl+Y</kbd>
                        </button>
                        <div class="pn-separator"></div>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick='() => PressKey(EditorKey.Cut)'>
                            <span>Cut</span><kbd>Ctrl+X</kbd>
                        </button>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick='() => PressKey(EditorKey.Copy)'>
                            <span>Copy</span><kbd>Ctrl+C</kbd>
                        </button>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick='() => PressKey(EditorKey.Paste)'>
                            <span>Paste</span><kbd>Ctrl+V</kbd>
                        </button>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick='() => PressKey(EditorKey.Duplicate)'>
                            <span>Duplicate node</span><kbd>Ctrl+D</kbd>
                        </button>
                        <div class="pn-separator"></div>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick='() => PressKey(EditorKey.SelectAll)'>
                            <span>Select all (value, node, document)</span><kbd>Ctrl+A</kbd>
                        </button>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick='() => PressKey(EditorKey.Delete)'>
                            <span>Delete</span><kbd>Del</kbd>
                        </button>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick='() => PressKey(EditorKey.ControlSpace)'>
                            <span>Complete</span><kbd>Ctrl+Space</kbd>
                        </button>
                        <button type="button" class="pn-entry" disabled="@(Active is null)" @onclick='() => PressKey(EditorKey.GoToDefinition)'>
                            <span>Go to definition</span><kbd>Ctrl+B</kbd>
                        </button>
                    </div>
                }
            </div>

            <div class="pn-menu">
                <button type="button" class="pn-menu-title" @onclick='() => ToggleMenu("view")'>View</button>
                @if (_menu == "view")
                {
                    <div class="pn-dropdown">
                        <button type="button" class="pn-entry" @onclick="ToggleProject">
                            <span>@(_showProject ? "Hide project explorer" : "Show project explorer")</span>
                        </button>
                        <button type="button" class="pn-entry" @onclick="ToggleProblems">
                            <span>@(_showProblems ? "Hide problems" : "Show problems")</span>
                        </button>
                        <button type="button" class="pn-entry" @onclick="ToggleTheme">
                            <span>@(_dark ? "Light theme" : "Dark theme")</span>
                        </button>
                        <div class="pn-separator"></div>
                        <button type="button" class="pn-entry" @onclick="() => Zoom(1)">
                            <span>Zoom in</span>
                        </button>
                        <button type="button" class="pn-entry" @onclick="() => Zoom(-1)">
                            <span>Zoom out</span>
                        </button>
                        <button type="button" class="pn-entry" @onclick="ResetZoom">
                            <span>Reset zoom</span>
                        </button>
                    </div>
                }
            </div>

            <div class="pn-menu">
                <button type="button" class="pn-menu-title" @onclick='() => ToggleMenu("help")'>Help</button>
                @if (_menu == "help")
                {
                    <div class="pn-dropdown">
                        <a class="pn-entry" href="../" target="_top">
                            <span>Language documentation</span>
                        </a>
                        <a class="pn-entry" href="https://github.com/furesoft/NodeLens.Avalonia" target="_blank" rel="noreferrer">
                            <span>Source on GitHub</span>
                        </a>
                        <div class="pn-separator"></div>
                        <div class="pn-hint">
                            <span><kbd>Enter</kbd> inserts a node, <kbd>Tab</kbd> walks the slots,</span>
                            <span><kbd>Alt+↑</kbd>/<kbd>Alt+↓</kbd> move the node at the caret,</span>
                            <span>double click selects a word, triple click its value,</span>
                            <span><kbd>Ctrl</kbd>+click or <kbd>Ctrl+B</kbd> goes to the definition.</span>
                        </div>
                    </div>
                }
            </div>
        </nav>

        <span class="pn-spacer"></span>
        <span class="pn-caption">@(Active?.Language.Name ?? "no document")</span>
    </header>

    <div class="pn-tabs">
        @foreach (var entry in Documents)
        {
            <div class="pn-tab @(ReferenceEquals(entry, Active) ? "pn-tab-active" : string.Empty)">
                <button type="button" class="pn-tab-name" @onclick="() => Activate(entry)">
                    <ShellIcon Kind="document" />
                    @if (entry.IsDirty)
                    {
                        <span class="pn-dirty" title="Not saved">●</span>
                    }
                    <span>@entry.Name</span>
                </button>
                <button type="button" class="pn-tab-close" title="Close" @onclick="() => CloseDocument(entry)">×</button>
            </div>
        }

        <div class="pn-menu">
            <button type="button" class="pn-tab-new" title="New document" @onclick='() => ToggleMenu("new")'>+</button>
            @if (_menu == "new")
            {
                <div class="pn-dropdown pn-dropdown-new">
                    @foreach (var language in Languages)
                    {
                        var chosen = language;

                        <button type="button" class="pn-entry" @onclick="() => NewDocument(chosen, sample: false)">
                            <span>@chosen.Name</span>
                        </button>
                    }
                    <div class="pn-separator"></div>
                    @foreach (var language in Languages)
                    {
                        var chosen = language;

                        <button type="button" class="pn-entry" @onclick="() => NewDocument(chosen, sample: true)">
                            <span>@chosen.Name example</span>
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <main class="pn-main">
        @if (_showProject)
        {
            <aside class="pn-project" aria-label="Project explorer">
                <header class="pn-panel-header">
                    <span>Project</span>
                    <span class="pn-spacer"></span>
                    <button type="button" title="Hide" @onclick="ToggleProject">×</button>
                </header>

                <div class="pn-panel-body">
                    <div class="pn-section">Structure</div>

                    @if (Active is null)
                    {
                        <p class="pn-panel-empty">No document.</p>
                    }
                    else
                    {
                        <div class="pn-tree-actions pn-outline-actions">
                            <button type="button" @onclick="ExpandOutline">Expand all</button>
                            <button type="button" @onclick="CollapseOutline">Collapse all</button>
                            <button type="button" @onclick="RevealCaret">Reveal caret</button>
                        </div>

                        <div class="pn-outline">
                            @foreach (var row in OutlineRows)
                            {
                                var branch = row;

                                <div class="pn-outline-row @(row.Id == CaretNode ? "pn-tree-active" : string.Empty)">
                                    <span class="pn-outline-indent" style="width:@(row.Depth * 12)px"></span>

                                    @if (branch.HasChildren)
                                    {
                                        <button type="button"
                                                class="pn-outline-chevron"
                                                title="@(branch.IsExpanded ? "Collapse" : "Expand")"
                                                @onclick="() => ToggleOutlineRow(branch.Id, branch.IsExpanded)">
                                            @(branch.IsExpanded ? "▾" : "▸")
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="pn-outline-chevron"></span>
                                    }

                                    <span class="pn-concept-badge"
                                          style="background:@ConceptBadge.ColorOf(branch.ConceptKey)"
                                          title="@branch.ConceptKey">@ConceptBadge.LetterOf(branch.ConceptKey)</span>

                                    <button type="button"
                                            class="pn-outline-name"
                                            title="@branch.ConceptKey"
                                            @onclick="() => GoToNode(branch.Id)">
                                        @branch.Text
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <div class="pn-section">Languages</div>

                    @if (Languages.Count == 0)
                    {
                        <p class="pn-panel-empty">Reading the example languages…</p>
                    }
                    else
                    {
                        @foreach (var language in Languages)
                        {
                            var chosen = language;

                            <details class="pn-tree-language">
                                <summary>
                                    <ShellIcon Kind="language" />
                                    <span>@chosen.Name</span>
                                    <span class="pn-count">@chosen.Concepts.Concepts.Count</span>
                                </summary>

                                <div class="pn-concepts">
                                    @foreach (var concept in chosen.Concepts.Concepts)
                                    {
                                        <span class="pn-concept" title="@concept.Key">@concept.Key</span>
                                    }
                                </div>

                                <div class="pn-tree-actions">
                                    <button type="button" @onclick="() => NewDocument(chosen, sample: false)">New</button>
                                    <button type="button" @onclick="() => NewDocument(chosen, sample: true)">Example</button>
                                </div>
                            </details>
                        }
                    }
                </div>
            </aside>
        }

        <div class="pn-documents">
            @if (Active is not { } current)
            {
                <div class="pn-empty">
                    <h1>No document is open</h1>
                    <p>Pick a language and start writing. The model is the program; the notation is derived from it.</p>
                    <div class="pn-empty-actions">
                        @foreach (var language in Languages.Take(4))
                        {
                            var chosen = language;

                            <button type="button" @onclick="() => NewDocument(chosen, sample: true)">@chosen.Name example</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="pn-scroll">
                    <div class="pn-paint"
                         @ref="_host"
                         @onpointerdown="OnPointerDown"
                         @onpointerdown:preventDefault="true"
                         @onpointermove="OnPointerMove"
                         @onpointerup="OnPointerUp"
                         @onpointerleave="OnPointerUp"
                         @onclick="OnClick"
                         @ondblclick="OnDoubleClick">
                        <div class="pn-layer">@((MarkupString)_canvas)</div>

                        @if (Completion is { } list)
                        {
                            @* A click on the list must not also move the caret, hence the stopped propagation. *@
                            <div class="pn-completion" style="@CompletionStyle" @onpointerdown:stopPropagation="true">
                                @if (list.Prefix.Length > 0)
                                {
                                    <div class="pn-completion-prefix">@list.Prefix</div>
                                }

                                @if (list.Matches.Count == 0)
                                {
                                    <div class="pn-completion-empty">no proposal matches</div>
                                }

                                @for (var index = 0; index < list.Matches.Count; index++)
                                {
                                    var item = list.Matches[index];
                                    var row = index;

                                    <button type="button"
                                            class="pn-completion-row @(index == list.SelectedIndex ? "pn-selected" : string.Empty)"
                                            @onclick="() => AcceptCompletion(row)">
                                        <span class="pn-completion-kind">@item.Kind</span>
                                        <span class="pn-completion-label">@item.Label</span>
                                        @if (item.Description is { Length: > 0 } description)
                                        {
                                            <span class="pn-completion-note">@description</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                @if (_showProblems)
                {
                    <aside class="pn-problems" aria-label="Problems">
                        <header class="pn-panel-header">
                            <span>Problems</span>
                            <span class="pn-badge">@current.Problems.Rows.Count</span>
                            <span class="pn-spacer"></span>
                            <button type="button" title="Hide" @onclick="ToggleProblems">×</button>
                        </header>

                        <div class="pn-panel-body">
                            @if (current.Problems.Rows.Count == 0)
                            {
                                <p class="pn-panel-empty">Nothing to report.</p>
                            }
                            else
                            {
                                @foreach (var row in current.Problems.Rows)
                                {
                                    <button type="button" class="pn-problem" @onclick="() => GoTo(row)">
                                        <span class="pn-severity pn-severity-@row.Severity.ToString().ToLowerInvariant()"></span>
                                        <span>@row.Message</span>
                                    </button>
                                }
                            }
                        </div>
                    </aside>
                }
            }
        </div>
    </main>

    <footer class="pn-status">
        <span class="pn-status-item">@(Active?.Language.Name ?? "—")</span>
        <span class="pn-status-item">@(Active is null ? string.Empty : $"{Active.NodeCount} nodes")</span>
        <button type="button" class="pn-status-button" @onclick="ToggleProblems">
            Problems (@(Active?.Problems.Rows.Count ?? 0))
        </button>
        <span class="pn-status-item">@(Active?.IsDirty == true ? "unsaved" : "saved")</span>
        <span class="pn-spacer"></span>
        <span class="pn-status-message">@_message</span>
        <span class="pn-status-item">@FontSize px</span>
    </footer>

    @* Hidden rather than absent: it is what the operating system's input method and the keyboard deliver to. *@
    <textarea @ref="_composer"
              class="pn-composer"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              aria-label="Editor input"></textarea>
</div>
