root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,axaml,xaml,xml,mps,json,yml,yaml,editorconfig}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Visual Studio rewrites solution files with CRLF; matches .gitattributes.
[*.{sln,slnx}]
end_of_line = crlf

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true