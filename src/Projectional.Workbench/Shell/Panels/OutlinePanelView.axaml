<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="using:Avalonia.Automation"
             x:Class="Projectional.Workbench.OutlinePanelView">
  <!-- The outline of the document in front, as the rows the shell derived from it. -->
  <ListBox
    x:Name="Rows"
    Classes="panelList"
    BorderThickness="0"
    Background="Transparent"
    a:AutomationProperties.Name="Outline" />
</UserControl>
