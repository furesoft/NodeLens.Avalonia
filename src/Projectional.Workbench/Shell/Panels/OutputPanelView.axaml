<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="using:Avalonia.Automation"
             x:Class="Projectional.Workbench.OutputPanelView">
  <!-- What running or generating the document in front produced, with the inputs the run needs above it. -->
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="8,6,8,4">
      <TextBlock
        Grid.Column="0"
        Text="Inputs"
        Classes="statusQuiet"
        Margin="0,0,8,0" />
      <TextBox
        x:Name="InputsBox"
        Grid.Column="1"
        a:AutomationProperties.Name="Run inputs"
        PlaceholderText="run inputs, e.g. amount=1500" />
      <Button x:Name="Run" Grid.Column="2" Margin="8,0,0,0" a:AutomationProperties.Name="Run the document">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="inlineIcon" Data="{DynamicResource IconPlay}" />
          <TextBlock Text="Run" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
    <ListBox
      x:Name="Rows"
      Classes="panelList"
      BorderThickness="0"
      Background="Transparent"
      FontFamily="Consolas,Menlo,monospace"
      a:AutomationProperties.Name="Run output" />
  </DockPanel>
</UserControl>
