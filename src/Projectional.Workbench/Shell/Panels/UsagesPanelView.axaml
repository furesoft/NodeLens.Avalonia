<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="using:Avalonia.Automation"
             x:Class="Projectional.Workbench.UsagesPanelView">
  <!-- Where the node under the caret is used. The rows are the shell's; the view is the list. -->
  <ListBox
    x:Name="Rows"
    Classes="panelList"
    BorderThickness="0"
    Background="Transparent"
    a:AutomationProperties.Name="Usages" />
</UserControl>
