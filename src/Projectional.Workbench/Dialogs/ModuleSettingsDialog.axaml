<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="using:Avalonia.Automation"
        xmlns:local="using:Projectional.Workbench"
        x:Class="Projectional.Workbench.ModuleSettingsDialog"
        Title="Module settings"
        Width="760"
        Height="540"
        MinWidth="560"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource WorkbenchChromeFontSize}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Projectional.Workbench/Styles/WorkbenchPalette.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- The same stroke-in-a-16-unit-box language the window's menu icons use, so a tab icon is not a second style. -->
      <StreamGeometry x:Key="IconCommon">M8,5.6 A2.4,2.4 0 1 0 8,10.4 A2.4,2.4 0 1 0 8,5.6 M8,2 V3.6 M8,12.4 V14 M2,8 H3.6 M12.4,8 H14 M3.8,3.8 L4.9,4.9 M11.1,11.1 L12.2,12.2 M12.2,3.8 L11.1,4.9 M4.9,11.1 L3.8,12.2</StreamGeometry>
      <StreamGeometry x:Key="IconDependencies">M6.5,9.5 A2.5,2.5 0 1 1 6.5,4.5 A2.5,2.5 0 1 1 6.5,9.5 M9.5,11.5 A2.5,2.5 0 1 0 9.5,6.5 M8,8 L8,8</StreamGeometry>
      <StreamGeometry x:Key="IconContents">M3,4 H13 M3,8 H13 M3,12 H13</StreamGeometry>
      <StreamGeometry x:Key="IconDocumentation">M3.5,1.8 H9.5 L12.5,4.8 V14.2 H3.5 Z M9.5,1.8 V4.8 H12.5 M5.5,8 H10.5 M5.5,10.5 H10.5</StreamGeometry>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <!-- A label beside a field: quiet, one line, and the same size as the window's chrome. -->
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource WorkbenchQuietTextBrush}" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource WorkbenchQuietTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.readonly">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Background" Value="{DynamicResource WorkbenchPanelBrush}" />
    </Style>
    <Style Selector="Border.page">
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WorkbenchQuietTextBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.footer">
      <Setter Property="Background" Value="{DynamicResource WorkbenchHeaderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchDividerBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="ListBox.table">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.table ListBoxItem">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="6,1" />
    </Style>
    <Style Selector="TabControl.dialogTabs TabItem">
      <Setter Property="FontSize" Value="{DynamicResource WorkbenchChromeFontSize}" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Path.tabIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{DynamicResource WorkbenchIconBrush}" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.dialog">
      <Setter Property="MinWidth" Value="88" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">
    <TabControl x:Name="Pages" Grid.Row="0" Padding="0" Classes="dialogTabs" a:AutomationProperties.Name="Module settings pages">
      <!-- Common: what the module is called, where it lives, and which versions it carries. -->
      <TabItem a:AutomationProperties.Name="Common">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="tabIcon" Data="{StaticResource IconCommon}" />
            <TextBlock Text="Common" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <Border Classes="page">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Name:" />
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Classes="readonly" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Module path:" />
            <TextBox x:Name="PathBox" Grid.Row="1" Grid.Column="1" Classes="readonly" Margin="0,0,0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Language version:" />
            <NumericUpDown
              x:Name="LanguageVersion"
              Grid.Row="2"
              Grid.Column="1"
              HorizontalAlignment="Left"
              Width="140"
              Minimum="0"
              Maximum="9999"
              Increment="1"
              FormatString="0"
              Margin="0,0,0,6"
              a:AutomationProperties.Name="Language version" />

            <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Module version:" />
            <NumericUpDown
              x:Name="ModuleVersion"
              Grid.Row="3"
              Grid.Column="1"
              HorizontalAlignment="Left"
              Width="140"
              Minimum="0"
              Maximum="9999"
              Increment="1"
              FormatString="0"
              a:AutomationProperties.Name="Module version" />

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Classes="section" Text="Model roots" />
            <ListBox
              x:Name="Roots"
              Grid.Row="5"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Classes="table"
              a:AutomationProperties.Name="Model roots">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </TabItem>

      <!-- Dependencies: which aspect is written in which language, including the aspects the module does not have. -->
      <TabItem a:AutomationProperties.Name="Dependencies">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="tabIcon" Data="{StaticResource IconDependencies}" />
            <TextBlock Text="Dependencies" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <Border Classes="page">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="180,*,80" Margin="6,0,6,0">
              <TextBlock Grid.Column="0" Classes="columnHeader" Text="Aspect" />
              <TextBlock Grid.Column="1" Classes="columnHeader" Text="Language" />
              <TextBlock Grid.Column="2" Classes="columnHeader" Text="Documents" HorizontalAlignment="Right" />
            </Grid>
            <ListBox
              x:Name="Dependencies"
              Grid.Row="1"
              Classes="table"
              a:AutomationProperties.Name="Dependencies">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ModuleAspect">
                  <Grid ColumnDefinitions="180,*,80">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding Language}" Foreground="{DynamicResource WorkbenchQuietTextBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Documents}" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </TabItem>

      <!-- Contents: what the shell lowered out of the module, which is the part nobody can see from the outside. -->
      <TabItem a:AutomationProperties.Name="Contents">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="tabIcon" Data="{StaticResource IconContents}" />
            <TextBlock Text="Contents" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <Border Classes="page">
          <Grid RowDefinitions="Auto,*">
            <TextBlock
              Grid.Row="0"
              Classes="hint"
              Margin="0,0,0,8"
              Text="What the workbench built from the module's definitions. A count of zero for a notation or a generator is what makes an empty page in a document." />
            <ListBox
              x:Name="Contents"
              Grid.Row="1"
              Classes="table"
              a:AutomationProperties.Name="Contents">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ModuleFact">
                  <Grid ColumnDefinitions="240,*">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </TabItem>

      <!-- Documentation: where generated documentation would be written. -->
      <TabItem a:AutomationProperties.Name="Documentation">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="tabIcon" Data="{StaticResource IconDocumentation}" />
            <TextBlock Text="Documentation" VerticalAlignment="Center" />
          </StackPanel>
        </TabItem.Header>
        <Border Classes="page">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Output path:" />
            <TextBox
              x:Name="DocumentationOutput"
              Grid.Row="0"
              Grid.Column="1"
              a:AutomationProperties.Name="Documentation output path" />
            <TextBlock
              Grid.Row="1"
              Grid.Column="1"
              Classes="hint"
              Margin="0,6,0,0"
              Text="Where this module's documentation is written. An empty path means no documentation is generated." />
          </Grid>
        </Border>
      </TabItem>
    </TabControl>

    <Border Grid.Row="1" Classes="footer">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          x:Name="Status"
          Grid.Column="0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource WorkbenchQuietTextBrush}"
          TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="OkButton" Classes="dialog" Content="OK" IsDefault="True" Click="OnOk" />
          <Button x:Name="CancelButton" Classes="dialog" Content="Cancel" IsCancel="True" />
          <Button x:Name="ApplyButton" Classes="dialog" Content="Apply" Click="OnApply" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
