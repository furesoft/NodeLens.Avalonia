<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!--
    The self-contained single file is a publish shape, not a build shape: a normal build stays
    framework-dependent and multi-file so the inner loop is fast, and only `dotnet publish` with
    PublishSingleFile bundles everything. IncludeNativeLibrariesForSelfExtract is what makes Avalonia's
    native dependencies part of the one file instead of a folder of .so/.dll beside it.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      "Single file" has to mean one file. A portable PDB per referenced project would otherwise be
      copied next to the bundle, so the publish turns debug information off and stops the reference
      copy step from bringing related files along.
    -->
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Projectional.Avalonia\Projectional.Avalonia.csproj" />
    <ProjectReference Include="..\Projectional.Editors\Projectional.Editors.csproj" />
    <ProjectReference Include="..\Projectional.IntentionRules\Projectional.IntentionRules.csproj" />
    <ProjectReference Include="..\Projectional.Languages\Projectional.Languages.csproj" />
    <ProjectReference Include="..\Projectional.LanguageExport\Projectional.LanguageExport.csproj" />
    <ProjectReference Include="..\Projectional.Expressions.Intentions\Projectional.Expressions.Intentions.csproj" />
    <ProjectReference Include="..\Projectional.Checks\Projectional.Checks.csproj" />
    <ProjectReference Include="..\Projectional.Json\Projectional.Json.csproj" />
    <ProjectReference Include="..\Projectional.Xml\Projectional.Xml.csproj" />
    <ProjectReference Include="..\Projectional.Intentions\Projectional.Intentions.csproj" />
    <ProjectReference Include="..\Projectional.Persistence\Projectional.Persistence.csproj" />
    <ProjectReference Include="..\Projectional.Samples\Projectional.Samples.csproj" />
    <ProjectReference Include="..\Projectional.Samples.Checks\Projectional.Samples.Checks.csproj" />
    <ProjectReference Include="..\Projectional.Samples.Intentions\Projectional.Samples.Intentions.csproj" />
    <ProjectReference Include="..\Projectional.Structures.Intentions\Projectional.Structures.Intentions.csproj" />
    <ProjectReference Include="..\Projectional.Structures\Projectional.Structures.csproj" />
    <ProjectReference Include="..\Projectional.TypeRules\Projectional.TypeRules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Projectional.Core.Tests" />
  </ItemGroup>

  <!--
    SkiaSharp and HarfBuzz ship a native .pdb beside their native library, and the native-asset copy
    step brings it along whatever AllowedReferenceRelatedFileExtensions says. A bundle that leaves two
    debug files next to it is not a single file, so the publish deletes them.
  -->
  <Target Name="RemovePublishPdbs" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <PublishPdbs Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishPdbs)" />
  </Target>

</Project>