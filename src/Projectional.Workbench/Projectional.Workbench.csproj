<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!--
    The self-contained single file is a publish shape, not a build shape: a normal build stays
    framework-dependent and multi-file so the inner loop is fast, and only `dotnet publish` with
    PublishSingleFile bundles everything. IncludeNativeLibrariesForSelfExtract is what makes Avalonia's
    native dependencies part of the one file instead of a folder of .so/.dll beside it.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      "Single file" has to mean one file. A portable PDB per referenced project would otherwise be
      copied next to the bundle, so the publish turns debug information off and stops the reference
      copy step from bringing related files along.
    -->
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!--
      The window is a docking layout: panels are dockables the user can move, float and close, and the document area is
      the layout's document dock rather than a hand-built tab strip.
    -->
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Avalonia" />
    <!--
      The terminal tool's emulator. The window is the only thing that has one: the engine is a dependency of the app
      rather than of the framework, so an embedder of the editor control pays for no terminal.
    -->
    <PackageReference Include="VtNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Projectional.Avalonia\Projectional.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.CSharp\Projectional.CSharp.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Editors\Projectional.Editors.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.IntentionRules\Projectional.IntentionRules.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Languages\Projectional.Languages.csproj" />
    <ProjectReference Include="..\..\src\Projectional.LanguageExport\Projectional.LanguageExport.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Checks\Projectional.Checks.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Json\Projectional.Json.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Hocon\Projectional.Hocon.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Toml\Projectional.Toml.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Yaml\Projectional.Yaml.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Xml\Projectional.Xml.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Intentions\Projectional.Intentions.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Persistence\Projectional.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Languages\Samples\Projectional.Samples\Projectional.Samples.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.Structures\Projectional.Structures.csproj" />
    <ProjectReference Include="..\..\src\Projectional.Testing\Projectional.Testing.csproj" />
    <ProjectReference Include="..\..\src\Languages\Projectional.TypeRules\Projectional.TypeRules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Projectional.Core.Tests" />
    <!--
      The screenshot tool hosts the shipping window and opens the worked-example document a picture needs through the
      same seam a tab is opened with. It is a repository harness like the tests - not a consumer proving the public
      surface - so it gets the same access and no more.
    -->
    <InternalsVisibleTo Include="Projectional.Screenshots" />
  </ItemGroup>

  <!--
    SkiaSharp and HarfBuzz ship a native .pdb beside their native library, and the native-asset copy
    step brings it along whatever AllowedReferenceRelatedFileExtensions says. A bundle that leaves two
    debug files next to it is not a single file, so the publish deletes them.
  -->
  <Target Name="RemovePublishPdbs" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <PublishPdbs Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishPdbs)" />
  </Target>

</Project>