<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Projectional.Workbench.MainWindow"
        Title="Projectional Workbench"
        Width="1200"
        Height="800">
  <!--
    The window is the desktop head and nothing else: its content is the shared `WorkbenchView`, which the browser head
    hosts in Avalonia's single view. Keeping the content out of the window is what makes one shell ship to both.
  -->
</Window>
