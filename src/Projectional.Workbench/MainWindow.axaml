<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Projectional.Workbench.MainWindow"
        Title="Projectional Workbench"
        Width="1200"
        Height="800">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" HotKey="Ctrl+N" Click="OnNewDocument" />
        <MenuItem Header="New language _definition" Click="OnNewLanguageDefinition" />
        <MenuItem Header="New _notation" Click="OnNewNotation" />
        <MenuItem Header="New document of an _opened language" Click="OnNewLanguageDocument" />
        <MenuItem Header="Open _language..." Click="OnOpenLanguage" />
        <MenuItem Header="_Open..." HotKey="Ctrl+O" Click="OnOpenDocument" />
        <Separator />
        <MenuItem Header="_Save" HotKey="Ctrl+S" Click="OnSaveDocument" />
        <MenuItem Header="Save _as..." HotKey="Ctrl+Shift+S" Click="OnSaveDocumentAs" />
        <Separator />
        <MenuItem Header="_Close document" HotKey="Ctrl+W" Click="OnCloseDocument" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="Representations" Header="_Representation" />
        <Separator />
        <MenuItem
          x:Name="LineNumbersItem"
          Header="Line _numbers"
          ToggleType="CheckBox"
          Click="OnToggleLineNumbers" />
        <Separator />
        <!--
          The gesture is written into the header rather than declared as a HotKey: the key that types
          "+" is OemPlus with Shift, so one registered gesture cannot match both the shifted and the
          unshifted press, and KeyGesture would print the enum name ("Ctrl+OemPlus") to the user.
        -->
        <MenuItem Header="_Increase font size (Ctrl+=)" Click="OnIncreaseFontSize" />
        <MenuItem Header="_Decrease font size (Ctrl+-)" Click="OnDecreaseFontSize" />
        <MenuItem Header="_Reset font size (Ctrl+0)" Click="OnResetFontSize" />
        <Separator />
        <!--
          One group of three rather than three toggles, because the choice is exclusive and "follow the
          system" is one of the choices - a checkbox would let a user tick two themes at once.
        -->
        <MenuItem
          x:Name="FollowSystemItem"
          GroupName="Theme"
          Header="Follow _system theme"
          ToggleType="Radio"
          IsChecked="True"
          Click="OnFollowSystemTheme" />
        <MenuItem
          x:Name="LightThemeItem"
          GroupName="Theme"
          Header="_Light theme"
          ToggleType="Radio"
          Click="OnLightTheme" />
        <MenuItem
          x:Name="DarkThemeItem"
          GroupName="Theme"
          Header="_Dark theme"
          ToggleType="Radio"
          Click="OnDarkTheme" />
      </MenuItem>
    </Menu>

    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="8,4">
      <TextBlock x:Name="StatusText" FontSize="12" />
    </Border>

    <!--
      The problems panel sits above the status bar and is hidden while there is nothing to report: an
      empty list would take a third of the window to say "no problems", which is the state a document is
      in most of the time.
    -->
    <Border x:Name="ProblemsPanel" DockPanel.Dock="Bottom" IsVisible="False" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock
          x:Name="ProblemsHeader"
          DockPanel.Dock="Top"
          Margin="8,6,8,2"
          FontSize="12"
          FontWeight="SemiBold"
          Text="Problems" />
        <ListBox
          x:Name="Problems"
          BorderThickness="0"
          MaxHeight="160"
          SelectionChanged="OnProblemChosen" />
      </DockPanel>
    </Border>

    <TabControl x:Name="Documents" Padding="0" FontSize="14">
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="14" />
          <Setter Property="Padding" Value="12,4" />
          <Setter Property="MinHeight" Value="28" />
        </Style>
      </TabControl.Styles>
    </TabControl>
  </DockPanel>
</Window>
