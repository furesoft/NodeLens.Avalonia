<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Projectional.Workbench.MainWindow"
        Title="Projectional Workbench"
        Width="1200"
        Height="800">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" HotKey="Ctrl+N" Click="OnNewDocument" />
        <MenuItem Header="New _concept" Click="OnNewConcept" />
        <MenuItem Header="New _enumeration" Click="OnNewEnumeration" />
        <MenuItem Header="New _notation" Click="OnNewNotation" />
        <MenuItem Header="New document of an _opened language" Click="OnNewLanguageDocument" />
        <MenuItem Header="Open _language..." Click="OnOpenLanguage" />
        <MenuItem x:Name="ExportLanguageItem" Header="E_xport language to C#..." IsEnabled="False" />
        <MenuItem Header="_Open..." HotKey="Ctrl+O" Click="OnOpenDocument" />
        <MenuItem x:Name="RecentFilesItem" Header="Recent" IsEnabled="False" />
        <Separator />
        <MenuItem Header="_Save" HotKey="Ctrl+S" Click="OnSaveDocument" />
        <MenuItem Header="Save _as..." HotKey="Ctrl+Shift+S" Click="OnSaveDocumentAs" />
        <MenuItem x:Name="SaveGeneratedItem" Header="Save _generated text as..." IsEnabled="False" Click="OnSaveGenerated" />
        <Separator />
        <MenuItem Header="_Close document" HotKey="Ctrl+W" Click="OnCloseDocument" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Run">
        <!--
          The gesture is written into the header rather than declared as a HotKey: the shell's own tunnelling
          handler owns F5, so the run cannot be claimed by whichever control happens to have focus.
        -->
        <MenuItem x:Name="RunDocumentItem" Header="_Run document (F5)" Click="OnRunDocument" />
        <MenuItem x:Name="GenerateItem" Header="_Generate text" IsEnabled="False" />
        <Separator />
        <MenuItem x:Name="ClearOutputItem" Header="_Clear output" Click="OnClearOutput" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Find..." HotKey="Ctrl+F" Click="OnFindText" />
        <Separator />
        <MenuItem x:Name="Representations" Header="_Representation" />
        <MenuItem Header="Reset column _widths" Click="OnResetColumnWidths" />
        <Separator />
        <MenuItem
          x:Name="LineNumbersItem"
          Header="Line _numbers"
          ToggleType="CheckBox"
          Click="OnToggleLineNumbers" />
        <Separator />
        <!--
          The gesture is written into the header rather than declared as a HotKey: the key that types
          "+" is OemPlus with Shift, so one registered gesture cannot match both the shifted and the
          unshifted press, and KeyGesture would print the enum name ("Ctrl+OemPlus") to the user.
        -->
        <MenuItem Header="_Increase font size (Ctrl+=)" Click="OnIncreaseFontSize" />
        <MenuItem Header="_Decrease font size (Ctrl+-)" Click="OnDecreaseFontSize" />
        <MenuItem Header="_Reset font size (Ctrl+0)" Click="OnResetFontSize" />
        <Separator />
        <!--
          One group of three rather than three toggles, because the choice is exclusive and "follow the
          system" is one of the choices - a checkbox would let a user tick two themes at once.
        -->
        <MenuItem
          x:Name="FollowSystemItem"
          GroupName="Theme"
          Header="Follow _system theme"
          ToggleType="Radio"
          IsChecked="True"
          Click="OnFollowSystemTheme" />
        <MenuItem
          x:Name="LightThemeItem"
          GroupName="Theme"
          Header="_Light theme"
          ToggleType="Radio"
          Click="OnLightTheme" />
        <MenuItem
          x:Name="DarkThemeItem"
          GroupName="Theme"
          Header="_Dark theme"
          ToggleType="Radio"
          Click="OnDarkTheme" />
      </MenuItem>
    </Menu>

    <!--
      The find bar is a strip rather than a dialog: a search is repeated, so it must not take the caret
      away from the document it searches - and the match count stays visible while the user reads.
    -->
    <Border x:Name="FindBar" DockPanel.Dock="Top" IsVisible="False" BorderThickness="0,0,0,1">
      <StackPanel Margin="8,6" Spacing="4">
        <Grid ColumnDefinitions="Auto,220,Auto,Auto,Auto" Margin="0">
          <TextBlock Grid.Column="0" Text="Find" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox
            x:Name="FindInput"
            Grid.Column="1"
            FontSize="12"
            TextChanged="OnFindQueryChanged"
            KeyDown="OnFindKeyDown" />
          <TextBlock
            x:Name="FindCount"
            Grid.Column="2"
            FontSize="12"
            VerticalAlignment="Center"
            Margin="8,0,8,0" />
          <CheckBox
            x:Name="FindCase"
            Grid.Column="3"
            Content="Match case"
            FontSize="12"
            VerticalAlignment="Center"
            IsCheckedChanged="OnFindQueryChanged" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0" Spacing="4">
            <Button Content="Previous" FontSize="12" Click="OnFindPrevious" />
            <Button Content="Next" FontSize="12" Click="OnFindNext" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="Auto,220,Auto,Auto" Margin="0">
          <TextBlock Grid.Column="0" Text="Replace" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox x:Name="ReplaceInput" Grid.Column="1" FontSize="12" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" Spacing="4">
            <Button Content="Replace" FontSize="12" Click="OnReplace" />
            <Button Content="Replace all" FontSize="12" Click="OnReplaceAll" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="8,4">
      <TextBlock x:Name="StatusText" FontSize="12" />
    </Border>
    <!--
      The output panel is where a run answers: the headline is the value or the reason there is none, and the
      rows under it are the trace. It is hidden until a document is run, for the same reason the problems
      panel is - an empty list that says nothing would cost a third of the window.
    -->
    <Border x:Name="OutputPanel" DockPanel.Dock="Bottom" IsVisible="False" BorderThickness="0,1,0,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="8,6,8,4">
          <TextBlock
            x:Name="OutputHeader"
            Grid.Column="0"
            FontSize="12"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
            Text="Output" />
          <TextBox
            x:Name="RunInputsInput"
            Grid.Column="1"
            Margin="12,0,0,0"
            FontSize="12"
            PlaceholderText="run inputs, e.g. amount=1500"
            KeyDown="OnRunInputsKeyDown" />
          <Button
            Grid.Column="2"
            Margin="8,0,0,0"
            FontSize="12"
            Content="Run"
            Click="OnRunDocument" />
        </Grid>
        <ListBox
          x:Name="RunOutput"
          BorderThickness="0"
          MaxHeight="180"
          FontFamily="Consolas,Menlo,monospace"
          FontSize="12"
          SelectionChanged="OnRunRowChosen">
          <!--
            A trace row is one line of text, so it is not allowed the theme's 32-pixel row: with the default height
            five steps overflow the panel and the last line - the answer's own line - is cut in half.
          -->
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="MinHeight" Value="18" />
              <Setter Property="Padding" Value="4,1" />
            </Style>
          </ListBox.Styles>
        </ListBox>
      </DockPanel>
    </Border>

    <!--
      The problems panel sits above the status bar and is hidden while there is nothing to report: an
      empty list would take a third of the window to say "no problems", which is the state a document is
      in most of the time.
    -->
    <Border x:Name="ProblemsPanel" DockPanel.Dock="Bottom" IsVisible="False" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock
          x:Name="ProblemsHeader"
          DockPanel.Dock="Top"
          Margin="8,6,8,2"
          FontSize="12"
          FontWeight="SemiBold"
          Text="Problems" />
        <ListBox
          x:Name="Problems"
          BorderThickness="0"
          MaxHeight="160"
          SelectionChanged="OnProblemChosen" />
      </DockPanel>
    </Border>

    <Border
      x:Name="OutlinePanel"
      DockPanel.Dock="Left"
      Width="220"
      BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock
          DockPanel.Dock="Top"
          Margin="8,6,8,2"
          FontSize="12"
          FontWeight="SemiBold"
          Text="Models" />
        <ListBox
          x:Name="OutlineList"
          BorderThickness="0"
          SelectionChanged="OnOutlineChosen" />
      </DockPanel>
    </Border>

    <TabControl x:Name="Documents" Padding="0" FontSize="14">
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="14" />
          <Setter Property="Padding" Value="12,4" />
          <Setter Property="MinHeight" Value="28" />
        </Style>
      </TabControl.Styles>
    </TabControl>
  </DockPanel>
</Window>
