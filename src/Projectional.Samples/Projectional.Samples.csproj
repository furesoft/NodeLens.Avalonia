<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One project per language (ADR 0021): the sample rules language and the behaviour that belongs to it - its
    constraints and duplicate-name check (`Checks/`) and its intentions (`Intentions/`). Both namespaces keep
    their names, so a host that names `Projectional.Samples.Checks.SampleConstraints` is unaffected.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Projectional.Checks\Projectional.Checks.csproj" />
    <ProjectReference Include="..\Projectional.Editing\Projectional.Editing.csproj" />
    <ProjectReference Include="..\Projectional.Expressions\Projectional.Expressions.csproj" />
    <ProjectReference Include="..\Projectional.Language\Projectional.Language.csproj" />
    <ProjectReference Include="..\Projectional.Projection\Projectional.Projection.csproj" />
    <ProjectReference Include="..\Projectional.Semantics\Projectional.Semantics.csproj" />
  </ItemGroup>

</Project>
