<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One project per language (ADR 0021): the expression sub-language and its intentions are this assembly,
    with the intentions in `Intentions/`. The namespace `Projectional.Expressions.Intentions` keeps its name,
    so a host that names an intention type is unaffected.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Projectional.Core\Projectional.Core.csproj" />
    <ProjectReference Include="..\Projectional.Editing\Projectional.Editing.csproj" />
    <ProjectReference Include="..\Projectional.Language\Projectional.Language.csproj" />
    <ProjectReference Include="..\Projectional.Projection\Projectional.Projection.csproj" />
  </ItemGroup>

</Project>
