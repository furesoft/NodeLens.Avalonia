<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <!--
      The window's areas are dockables: a panel can be dragged to another edge, floated, or closed by the same gesture
      in every place, and the document area is the layout's document dock. The version tracks Avalonia's - Dock 12.1.5
      is built against Avalonia 12.1.5, and a patch difference is what NuGet resolves upward.
    -->
    <PackageVersion Include="Dock.Avalonia" Version="12.1.5" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageVersion Include="Dock.Model.Avalonia" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup Label="Terminal">
    <!--
      The emulator behind the shell's terminal tool: a VT100/xterm state machine by the author of VtNetCore, MIT, and a
      netstandard2.0 library with no Avalonia in it. Only the engine is taken - the Avalonia control that lives beside
      it on GitHub is Avalonia 0.10 code from 2021 and exists on no feed, while the shell's own control is thirty lines
      of painting per row and can follow the framework's theme (ADR 0023).
    -->
    <PackageVersion Include="VtNetCore" Version="1.0.30" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup Label="Web">
    <!--
      The browser sample's runtime and its development server. Both follow the SDK's band: the sample is a
      demonstration of the framework in a browser, not a second product with a support window of its own.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
  </ItemGroup>


  <ItemGroup Label="Build">
    <!--
      Derives the package version from the git history and the `v*` tags (GitVersion.yml) instead of a
      hand-typed number. `PrivateAssets="all"` keeps it out of what a consumer of a package inherits.
    -->
    <PackageVersion Include="GitVersion.MsBuild" Version="6.8.2" />
  </ItemGroup>

  <ItemGroup Label="Languages">
    <!--
      The readers of the reference languages that spell a format .NET has no reader for. They are dependencies of
      the language package that needs them and never of the toolkit (open question 98): a host opts into TOML or
      YAML by naming that language, and a host that wants neither pays for neither.
    -->
    <PackageVersion Include="Tomlyn" Version="2.11.1" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup Label="Export">
    <!--
      The export compiles the source it just wrote in-process, so what a language becomes can be a package
      without a toolchain: a host that ships the exporter needs no SDK, no temporary project and no shell.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

</Project>